{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.typaxis.invalid/1.3/machine-footnote-manifest.schema.json",
  "title": "Typaxis Machine Footnote Layout Manifest 1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "body_layout_sha256",
    "pages",
    "paint_sha256",
    "profile_sha256",
    "registry_sha256",
    "selected_layout_sha256"
  ],
  "properties": {
    "algorithm": {"const": "typaxis.footnote-manifest/1"},
    "body_layout_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "paint_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "profile_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "registry_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "selected_layout_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "nonnegative_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_fragment",
        "assignment_ordinal",
        "before_fragment",
        "carries_out",
        "flow_id",
        "footnote_id",
        "incoming_source_page"
      ],
      "properties": {
        "after_fragment": {"$ref": "#/$defs/u32"},
        "assignment_ordinal": {"$ref": "#/$defs/u32"},
        "before_fragment": {"$ref": "#/$defs/u32"},
        "carries_out": {"type": "boolean"},
        "flow_id": {"$ref": "#/$defs/u32"},
        "footnote_id": {"$ref": "common.schema.json#/$defs/footnote_id"},
        "incoming_source_page": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/u32"}
          ]
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_continuation_position",
        "body_continuation_terminal",
        "body_fingerprint",
        "evaluation_count",
        "flows",
        "ordered_footnote_ids",
        "page_index",
        "reservation"
      ],
      "properties": {
        "body_continuation_position": {"$ref": "#/$defs/u32"},
        "body_continuation_terminal": {"type": "boolean"},
        "body_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "evaluation_count": {"type": "integer", "minimum": 2, "maximum": 65536},
        "flows": {"type": "array", "items": {"$ref": "#/$defs/flow"}},
        "ordered_footnote_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/footnote_id"}
        },
        "page_index": {"$ref": "#/$defs/u32"},
        "reservation": {"$ref": "#/$defs/nonnegative_safe_integer"}
      }
    }
  }
}
