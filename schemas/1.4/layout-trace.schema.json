{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.typaxis.invalid/1.4/layout-trace.schema.json",
  "title": "Typaxis Layout Trace 1.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "coordinate_unit"],
  "properties": {
    "advanced_pagination": {"$ref": "machine-advanced-pagination-manifest.schema.json"},
    "block_layout_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "contract": {"$ref": "common.schema.json#/$defs/contract"},
    "coordinate_unit": {"$ref": "common.schema.json#/$defs/coordinate_unit"},
    "flow_registry_sha256": {
      "oneOf": [
        {"$ref": "common.schema.json#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "fragment_count": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
    "footnote_layout": {"$ref": "machine-footnote-manifest.schema.json"},
    "max_layout_passes": {"type": "integer", "minimum": 1, "maximum": 65535},
    "initial_state": {"$ref": "#/$defs/initial_pagination_state_record"},
    "initial_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
    "inline_layout_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "passes": {"type": "array", "items": {"$ref": "#/$defs/pass"}},
    "precomposed_vector_block_layout": {"$ref": "#/$defs/precomposed_vector_block_layout"},
    "precomposed_vector_layout": {"$ref": "#/$defs/precomposed_vector_layout"},
    "profile_receipt_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "result": {"$ref": "#/$defs/result"},
    "selected_layout_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "table_layouts": {"type": "array", "items": {"$ref": "machine-table-manifest.schema.json"}},
    "vector_display_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "oneOf": [
    {
      "required": ["max_layout_passes", "initial_state", "initial_fingerprint", "passes", "result"],
      "not": {
        "anyOf": [
          {"required": ["advanced_pagination"]},
          {"required": ["precomposed_vector_block_layout"]},
          {"required": ["precomposed_vector_layout"]}
        ]
      }
    },
    {
      "required": ["advanced_pagination", "flow_registry_sha256", "profile_receipt_sha256"],
      "properties": {
        "flow_registry_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      },
      "not": {
        "anyOf": [
          {"required": ["footnote_layout"]},
          {"required": ["initial_fingerprint"]},
          {"required": ["initial_state"]},
          {"required": ["max_layout_passes"]},
          {"required": ["passes"]},
          {"required": ["precomposed_vector_block_layout"]},
          {"required": ["precomposed_vector_layout"]},
          {"required": ["result"]},
          {"required": ["table_layouts"]}
        ]
      }
    },
    {
      "required": ["precomposed_vector_layout"],
      "not": {
        "anyOf": [
          {"required": ["advanced_pagination"]},
          {"required": ["flow_registry_sha256"]},
          {"required": ["footnote_layout"]},
          {"required": ["initial_fingerprint"]},
          {"required": ["initial_state"]},
          {"required": ["max_layout_passes"]},
          {"required": ["passes"]},
          {"required": ["precomposed_vector_block_layout"]},
          {"required": ["profile_receipt_sha256"]},
          {"required": ["result"]},
          {"required": ["table_layouts"]}
        ]
      }
    },
    {
      "required": ["precomposed_vector_block_layout"],
      "not": {
        "anyOf": [
          {"required": ["advanced_pagination"]},
          {"required": ["flow_registry_sha256"]},
          {"required": ["footnote_layout"]},
          {"required": ["initial_fingerprint"]},
          {"required": ["initial_state"]},
          {"required": ["max_layout_passes"]},
          {"required": ["passes"]},
          {"required": ["precomposed_vector_layout"]},
          {"required": ["profile_receipt_sha256"]},
          {"required": ["result"]},
          {"required": ["table_layouts"]}
        ]
      }
    },
    {
      "required": ["block_layout_sha256", "flow_registry_sha256", "fragment_count", "inline_layout_sha256", "profile_receipt_sha256", "selected_layout_sha256", "vector_display_sha256"],
      "properties": {
        "flow_registry_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      },
      "not": {
        "anyOf": [
          {"required": ["advanced_pagination"]},
          {"required": ["footnote_layout"]},
          {"required": ["initial_fingerprint"]},
          {"required": ["initial_state"]},
          {"required": ["max_layout_passes"]},
          {"required": ["passes"]},
          {"required": ["precomposed_vector_block_layout"]},
          {"required": ["precomposed_vector_layout"]},
          {"required": ["result"]},
          {"required": ["table_layouts"]}
        ]
      }
    }
  ],
  "$defs": {
    "precomposed_vector_page_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "body", "master_id", "page_height", "page_width"],
      "properties": {
        "algorithm": {"const": "typaxis.safe-vector-page-geometry/1"},
        "body": {"$ref": "common.schema.json#/$defs/rect"},
        "master_id": {"$ref": "common.schema.json#/$defs/master_id"},
        "page_height": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "page_width": {"$ref": "common.schema.json#/$defs/positive_safe_integer"}
      }
    },
    "precomposed_vector_itemization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemization_fingerprint", "line_selection_fingerprint", "paragraph_node"],
      "properties": {
        "itemization_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "line_selection_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "paragraph_node": {"$ref": "common.schema.json#/$defs/id32"}
      }
    },
    "precomposed_vector_line_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_y", "break_demerits", "content_ascent", "content_descent", "end_unit", "fragment_ordinal", "frame_index", "itemization_fingerprint", "leading_after", "leading_before", "line_height", "line_index", "line_selection_fingerprint", "line_top", "logical_advance", "page_index", "paragraph_line_index", "paragraph_node", "start_unit", "visual_left", "visual_right"],
      "properties": {
        "baseline_y": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "break_demerits": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "content_ascent": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "content_descent": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "end_unit": {"$ref": "common.schema.json#/$defs/id32"},
        "fragment_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "frame_index": {"$ref": "common.schema.json#/$defs/id32"},
        "itemization_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "leading_after": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "leading_before": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "line_height": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "line_index": {"$ref": "common.schema.json#/$defs/id32"},
        "line_selection_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "line_top": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "logical_advance": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "page_index": {"$ref": "common.schema.json#/$defs/id32"},
        "paragraph_line_index": {"$ref": "common.schema.json#/$defs/id32"},
        "paragraph_node": {"$ref": "common.schema.json#/$defs/id32"},
        "start_unit": {"$ref": "common.schema.json#/$defs/id32"},
        "visual_left": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/safe_integer"},
            {"type": "null"}
          ]
        },
        "visual_right": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/safe_integer"},
            {"type": "null"}
          ]
        }
      }
    },
    "precomposed_vector_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "record"],
      "properties": {
        "fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "record": {"$ref": "#/$defs/precomposed_vector_line_record"}
      }
    },
    "precomposed_vector_spacing_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "before"],
      "properties": {
        "after": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "before": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"}
      }
    },
    "precomposed_vector_placement_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atomic_item_fingerprint", "baseline", "baseline_y", "binding_fingerprint", "fragment_ordinal", "frame_index", "line_index", "node_id", "occurrence", "page_index", "paint_ordinal", "paragraph_node", "pen_origin_x", "scale", "spacing", "viewport"],
      "properties": {
        "atomic_item_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "baseline": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "baseline_y": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "binding_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "fragment_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "frame_index": {"$ref": "common.schema.json#/$defs/id32"},
        "line_index": {"$ref": "common.schema.json#/$defs/id32"},
        "node_id": {"$ref": "common.schema.json#/$defs/id32"},
        "occurrence": {"$ref": "common.schema.json#/$defs/id32"},
        "page_index": {"$ref": "common.schema.json#/$defs/id32"},
        "paint_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "paragraph_node": {"$ref": "common.schema.json#/$defs/id32"},
        "pen_origin_x": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "scale": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "spacing": {"$ref": "#/$defs/precomposed_vector_spacing_decision"},
        "viewport": {"$ref": "common.schema.json#/$defs/rect"}
      }
    },
    "precomposed_vector_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "record"],
      "properties": {
        "fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "record": {"$ref": "#/$defs/precomposed_vector_placement_record"}
      }
    },
    "precomposed_vector_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted_fingerprint", "algorithm", "binding_set_fingerprint", "fragment_charge", "itemizations", "layout_epoch_fingerprint", "limits_fingerprint", "line_count", "lines", "package_sha256", "page_geometry", "page_geometry_fingerprint", "placement_count", "placements", "profile_fingerprint"],
      "properties": {
        "admitted_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "algorithm": {"const": "typaxis.precomposed-vector-layout/1"},
        "binding_set_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "fragment_charge": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "itemizations": {"type": "array", "items": {"$ref": "#/$defs/precomposed_vector_itemization"}},
        "layout_epoch_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "limits_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "line_count": {"$ref": "common.schema.json#/$defs/id32"},
        "lines": {"type": "array", "items": {"$ref": "#/$defs/precomposed_vector_line"}},
        "package_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "page_geometry": {"$ref": "#/$defs/precomposed_vector_page_geometry"},
        "page_geometry_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "placement_count": {"$ref": "common.schema.json#/$defs/id32"},
        "placements": {"type": "array", "items": {"$ref": "#/$defs/precomposed_vector_placement"}},
        "profile_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "precomposed_vector_block_caption_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_size", "owner"],
      "properties": {
        "block_size": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "owner": {"$ref": "common.schema.json#/$defs/id32"}
      }
    },
    "precomposed_vector_block_keep_successor_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "required_extent_after_vector", "successor_owner"],
      "properties": {
        "owner": {"$ref": "common.schema.json#/$defs/id32"},
        "required_extent_after_vector": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "successor_owner": {"$ref": "common.schema.json#/$defs/id32"}
      }
    },
    "precomposed_vector_block_pagination_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["captions", "initial_consumed_block_size", "keep_successors", "preparation_fingerprint", "prior_fragment_charge"],
      "properties": {
        "captions": {"type": "array", "items": {"$ref": "#/$defs/precomposed_vector_block_caption_input"}},
        "initial_consumed_block_size": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "keep_successors": {"type": "array", "items": {"$ref": "#/$defs/precomposed_vector_block_keep_successor_input"}},
        "preparation_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "prior_fragment_charge": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"}
      }
    },
    "precomposed_vector_block_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_count", "caption_count", "page_index"],
      "properties": {
        "block_count": {"$ref": "common.schema.json#/$defs/id32"},
        "caption_count": {"$ref": "common.schema.json#/$defs/id32"},
        "page_index": {"$ref": "common.schema.json#/$defs/id32"}
      }
    },
    "precomposed_vector_block_caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption_flow_id", "owner", "page_index", "paint_ordinal", "rect"],
      "properties": {
        "caption_flow_id": {"$ref": "common.schema.json#/$defs/id32"},
        "owner": {"$ref": "common.schema.json#/$defs/id32"},
        "page_index": {"$ref": "common.schema.json#/$defs/id32"},
        "paint_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "rect": {"$ref": "common.schema.json#/$defs/rect"}
      }
    },
    "precomposed_vector_block_equation_number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_gap", "owner", "paint_ordinal", "rect", "shape_fingerprint", "source_span"],
      "properties": {
        "minimum_gap": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "owner": {"$ref": "common.schema.json#/$defs/id32"},
        "paint_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "rect": {"$ref": "common.schema.json#/$defs/rect"},
        "shape_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "source_span": {"$ref": "common.schema.json#/$defs/source_span"}
      }
    },
    "precomposed_vector_block_math_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "baseline_y", "pen_origin_x"],
      "properties": {
        "baseline": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "baseline_y": {"$ref": "common.schema.json#/$defs/safe_integer"},
        "pen_origin_x": {"$ref": "common.schema.json#/$defs/safe_integer"}
      }
    },
    "precomposed_vector_block_math_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_fingerprint", "flow_id", "terminal", "terminal_receipt_fingerprint"],
      "properties": {
        "flow_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "flow_id": {"$ref": "common.schema.json#/$defs/id32"},
        "terminal": {"const": 1},
        "terminal_receipt_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "precomposed_vector_block_structure_child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "page_index", "paint_ordinal", "rect", "role"],
      "properties": {
        "owner": {"$ref": "common.schema.json#/$defs/id32"},
        "page_index": {"$ref": "common.schema.json#/$defs/id32"},
        "paint_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "rect": {"$ref": "common.schema.json#/$defs/rect"},
        "role": {"enum": ["caption", "equation_number", "figure", "formula"]}
      }
    },
    "precomposed_vector_block_viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix", "paint_ordinal", "rect", "scale"],
      "properties": {
        "matrix": {"$ref": "common.schema.json#/$defs/affine_transform"},
        "paint_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "rect": {"$ref": "common.schema.json#/$defs/rect"},
        "scale": {"$ref": "common.schema.json#/$defs/positive_unitless_16_16"}
      }
    },
    "precomposed_vector_block_placement_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_fingerprint", "block_ordinal", "captions", "effective_space_after", "effective_space_before", "end_indent", "equation_number", "forced_page_break_before", "fragment_ordinal", "frame_index", "image_id", "keep_caption", "keep_with_next", "kind", "math_baseline", "math_flow", "moved_to_fresh_page", "node_id", "page_block_ordinal", "page_index", "pagination_bounds", "paint_bounds", "parent_flow_id", "parent_position", "requested_page", "requested_space_after", "requested_space_before", "source_span", "start_indent", "structure_bounds", "structure_children", "style_fingerprint", "text_align", "viewport"],
      "properties": {
        "binding_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "block_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "captions": {"type": "array", "items": {"$ref": "#/$defs/precomposed_vector_block_caption"}},
        "effective_space_after": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "effective_space_before": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "end_indent": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "equation_number": {
          "oneOf": [
            {"$ref": "#/$defs/precomposed_vector_block_equation_number"},
            {"type": "null"}
          ]
        },
        "forced_page_break_before": {"type": "boolean"},
        "fragment_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "frame_index": {"const": 0},
        "image_id": {"$ref": "common.schema.json#/$defs/id32"},
        "keep_caption": {"type": "boolean"},
        "keep_with_next": {"type": "boolean"},
        "kind": {"enum": ["math_vector_block", "vector_figure"]},
        "math_baseline": {
          "oneOf": [
            {"$ref": "#/$defs/precomposed_vector_block_math_baseline"},
            {"type": "null"}
          ]
        },
        "math_flow": {
          "oneOf": [
            {"$ref": "#/$defs/precomposed_vector_block_math_flow"},
            {"type": "null"}
          ]
        },
        "moved_to_fresh_page": {"type": "boolean"},
        "node_id": {"$ref": "common.schema.json#/$defs/id32"},
        "page_block_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "page_index": {"$ref": "common.schema.json#/$defs/id32"},
        "pagination_bounds": {"$ref": "common.schema.json#/$defs/rect"},
        "paint_bounds": {"$ref": "common.schema.json#/$defs/rect"},
        "parent_flow_id": {"$ref": "common.schema.json#/$defs/id32"},
        "parent_position": {"$ref": "common.schema.json#/$defs/id32"},
        "requested_page": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/master_id"},
            {"type": "null"}
          ]
        },
        "requested_space_after": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "requested_space_before": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "source_span": {"$ref": "common.schema.json#/$defs/source_span"},
        "start_indent": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "structure_bounds": {"$ref": "common.schema.json#/$defs/rect"},
        "structure_children": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/precomposed_vector_block_structure_child"}},
        "style_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "text_align": {"enum": ["center", "end", "start"]},
        "viewport": {"$ref": "#/$defs/precomposed_vector_block_viewport"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "vector_figure"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "equation_number": {"type": "null"},
              "math_baseline": {"type": "null"},
              "math_flow": {"type": "null"},
              "structure_children": {
                "minItems": 1,
                "prefixItems": [
                  {"properties": {"role": {"const": "figure"}}}
                ],
                "items": {"properties": {"role": {"const": "caption"}}}
              }
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "math_vector_block"}}, "required": ["kind"]},
          "then": {
            "properties": {
              "captions": {"maxItems": 0},
              "keep_caption": {"const": false},
              "math_baseline": {"$ref": "#/$defs/precomposed_vector_block_math_baseline"},
              "math_flow": {"$ref": "#/$defs/precomposed_vector_block_math_flow"},
              "structure_children": {
                "minItems": 1,
                "maxItems": 2,
                "prefixItems": [
                  {"properties": {"role": {"const": "formula"}}},
                  {"properties": {"role": {"const": "equation_number"}}}
                ],
                "items": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "math_vector_block"},
              "equation_number": {"type": "null"}
            },
            "required": ["equation_number", "kind"]
          },
          "then": {
            "properties": {
              "structure_children": {"maxItems": 1}
            }
          },
          "else": {
            "if": {
              "properties": {"kind": {"const": "math_vector_block"}},
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "structure_children": {"minItems": 2}
              }
            }
          }
        }
      ]
    },
    "precomposed_vector_block_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "record"],
      "properties": {
        "fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "record": {"$ref": "#/$defs/precomposed_vector_block_placement_record"}
      }
    },
