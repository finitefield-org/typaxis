{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.typaxis.invalid/1.4/machine-table-manifest.schema.json",
  "title": "Typaxis Machine Table Layout Manifest 1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "body_block_size",
    "columns",
    "first_page_remaining_block_size",
    "flow_registry_sha256",
    "grid_sha256",
    "header_occurrences",
    "header_sources",
    "page_count",
    "residual_recipient",
    "rounding_residual",
    "row_band_sha256",
    "rows",
    "selected_layout_sha256",
    "table_node_id",
    "target_page_start"
  ],
  "properties": {
    "algorithm": {"const": "typaxis.table-layout-manifest/1"},
    "body_block_size": {"$ref": "#/$defs/positive_safe_integer"},
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/column"}
    },
    "first_page_remaining_block_size": {"$ref": "#/$defs/positive_safe_integer"},
    "flow_registry_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "grid_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "header_occurrences": {
      "type": "array",
      "items": {"$ref": "#/$defs/header_occurrence"}
    },
    "header_sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/header_source"}
    },
    "page_count": {"$ref": "#/$defs/positive_u32"},
    "residual_recipient": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/u32"}
      ]
    },
    "rounding_residual": {"$ref": "#/$defs/safe_integer"},
    "row_band_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/row"}
    },
    "selected_layout_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "table_node_id": {"$ref": "common.schema.json#/$defs/id32"},
    "target_page_start": {"$ref": "#/$defs/u32"}
  },
  "$defs": {
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "positive_u32": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "safe_integer": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "nonnegative_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "column_ordinal",
        "final_width",
        "input_kind",
        "input_value",
        "rounded_fraction_width"
      ],
      "properties": {
        "column_ordinal": {"$ref": "#/$defs/u32"},
        "final_width": {"$ref": "#/$defs/positive_safe_integer"},
        "input_kind": {"enum": ["fixed", "fraction"]},
        "input_value": {"$ref": "#/$defs/positive_safe_integer"},
        "rounded_fraction_width": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/nonnegative_safe_integer"}
          ]
        }
      }
    },
    "cell_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow_id", "next_fragment_ordinal", "terminal"],
      "properties": {
        "flow_id": {"$ref": "#/$defs/u32"},
        "next_fragment_ordinal": {"$ref": "#/$defs/u32"},
        "terminal": {"type": "boolean"}
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "logical_row_ordinal"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {"$ref": "#/$defs/continuation_entry"}
        },
        "logical_row_ordinal": {"$ref": "#/$defs/u32"}
      }
    },
    "continuation_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_flow_cursor",
        "cell_node_id",
        "column_ordinal",
        "flow_id",
        "remaining_logical_rows",
        "vertical_offset"
      ],
      "properties": {
        "cell_flow_cursor": {"$ref": "#/$defs/cell_cursor"},
        "cell_node_id": {"$ref": "common.schema.json#/$defs/id32"},
        "column_ordinal": {"$ref": "#/$defs/u32"},
        "flow_id": {"$ref": "#/$defs/u32"},
        "remaining_logical_rows": {"type": "integer", "minimum": 1, "maximum": 65535},
        "vertical_offset": {"$ref": "#/$defs/nonnegative_safe_integer"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_fragment_ordinal",
        "after_terminal",
        "before_fragment_ordinal",
        "before_terminal",
        "cell_node_id",
        "column_ordinal",
        "colspan",
        "flow_id",
        "rowspan",
        "selected_block_extent",
        "vertical_offset_after",
        "vertical_offset_before"
      ],
      "properties": {
        "after_fragment_ordinal": {"$ref": "#/$defs/u32"},
        "after_terminal": {"type": "boolean"},
        "before_fragment_ordinal": {"$ref": "#/$defs/u32"},
        "before_terminal": {"type": "boolean"},
        "cell_node_id": {"$ref": "common.schema.json#/$defs/id32"},
        "column_ordinal": {"$ref": "#/$defs/u32"},
        "colspan": {"type": "integer", "minimum": 1, "maximum": 65535},
        "flow_id": {"$ref": "#/$defs/u32"},
        "rowspan": {"type": "integer", "minimum": 1, "maximum": 65535},
        "selected_block_extent": {"$ref": "#/$defs/nonnegative_safe_integer"},
        "vertical_offset_after": {"$ref": "#/$defs/nonnegative_safe_integer"},
        "vertical_offset_before": {"$ref": "#/$defs/nonnegative_safe_integer"}
      }
    },
    "header_occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fragment_id",
        "repetition_index",
        "row_node_id",
        "source_fragment_id",
        "target_block_offset",
        "target_page_index"
      ],
      "properties": {
        "fragment_id": {"$ref": "#/$defs/nonnegative_safe_integer"},
        "repetition_index": {"$ref": "#/$defs/u32"},
        "row_node_id": {"$ref": "common.schema.json#/$defs/id32"},
        "source_fragment_id": {"$ref": "#/$defs/nonnegative_safe_integer"},
        "target_block_offset": {"$ref": "#/$defs/nonnegative_safe_integer"},
        "target_page_index": {"$ref": "#/$defs/u32"}
      }
    },
    "header_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "group_block_offset",
        "row_node_id",
        "row_ordinal",
        "selected_block_extent",
        "source_fragment_id"
      ],
      "properties": {
        "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}},
        "group_block_offset": {"$ref": "#/$defs/nonnegative_safe_integer"},
        "row_node_id": {"$ref": "common.schema.json#/$defs/id32"},
        "row_ordinal": {"$ref": "#/$defs/u32"},
        "selected_block_extent": {"$ref": "#/$defs/nonnegative_safe_integer"},
        "source_fragment_id": {"$ref": "#/$defs/nonnegative_safe_integer"}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "continuation_after",
        "continuation_before",
        "fragment_id",
        "logical_row_ordinal",
        "page_block_offset",
        "page_index",
        "row_fragment_ordinal",
        "row_node_id",
        "selected_block_extent"
      ],
      "properties": {
        "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}},
        "continuation_after": {"$ref": "#/$defs/continuation"},
        "continuation_before": {"$ref": "#/$defs/continuation"},
        "fragment_id": {"$ref": "#/$defs/nonnegative_safe_integer"},
        "logical_row_ordinal": {"$ref": "#/$defs/u32"},
        "page_block_offset": {"$ref": "#/$defs/nonnegative_safe_integer"},
        "page_index": {"$ref": "#/$defs/u32"},
        "row_fragment_ordinal": {"$ref": "#/$defs/u32"},
        "row_node_id": {"$ref": "common.schema.json#/$defs/id32"},
        "selected_block_extent": {"$ref": "#/$defs/nonnegative_safe_integer"}
      }
    }
  }
}
