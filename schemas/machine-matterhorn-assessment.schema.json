{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.typaxis.invalid/1.4/machine-matterhorn-assessment.schema.json",
  "title": "Typaxis Matterhorn Protocol Assessment 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "fixture", "items", "pdf_sha256", "protocol", "review", "validator"],
  "properties": {
    "contract": {"const": "typaxis.matterhorn-assessment/2"},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "revision_sha256"],
      "properties": {
        "fixture_id": {"const": "mi4-v19.production-readiness"},
        "revision_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "items": {
      "type": "array",
      "minItems": 136,
      "maxItems": 136,
      "items": {"$ref": "#/$defs/item"}
    },
    "pdf_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_item_count", "item_count", "machine_item_count", "no_specific_test_item_count", "source", "version"],
      "properties": {
        "human_item_count": {"const": 47},
        "item_count": {"const": 136},
        "machine_item_count": {"const": 87},
        "no_specific_test_item_count": {"const": 2},
        "source": {"const": "https://www.pdfa.org/wp-content/uploads/2014/06/PDFUA-1_MatterhornProtocol_1-02.pdf"},
        "version": {"const": "1.02"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "reviewed_on", "reviewer", "status_counts"],
      "properties": {
        "method": {"const": "closed-fixture-human-semantic-review/1"},
        "reviewed_on": {"type": "string", "format": "date"},
        "reviewer": {"type": "string", "minLength": 1},
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_applicable", "passed"],
          "properties": {
            "not_applicable": {"const": 37},
            "passed": {"const": 99}
          }
        }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flavour", "id", "version"],
      "properties": {
        "flavour": {"const": "ua1"},
        "id": {"const": "veraPDF Greenfield"},
        "version": {"const": "1.30.2"}
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "id", "method", "rationale", "status"],
      "properties": {
        "evidence": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{3}$"},
        "method": {"enum": ["human", "machine", "no_specific_test"]},
        "rationale": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "status": {"enum": ["not_applicable", "passed"]}
      }
    }
  }
}
