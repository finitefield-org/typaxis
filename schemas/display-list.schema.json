{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.typaxis.invalid/1.4/display-list.schema.json",
  "title": "Typaxis Display List 1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "coordinate_unit"
  ],
  "properties": {
    "contract": {
      "$ref": "common.schema.json#/$defs/contract"
    },
    "coordinate_unit": {
      "$ref": "common.schema.json#/$defs/coordinate_unit"
    },
    "source_layout": {
      "$ref": "#/$defs/source_layout"
    },
    "text_buffers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/display_text_buffer"
      }
    },
    "font_instances": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/font_instance"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "destinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/named_destination"
      }
    },
    "precomposed_vector_display": {
      "$ref": "#/$defs/precomposed_vector_display"
    }
  },
  "oneOf": [
    {
      "required": [
        "source_layout",
        "text_buffers",
        "font_instances",
        "destinations",
        "pages"
      ],
      "not": {
        "required": ["precomposed_vector_display"]
      }
    },
    {
      "required": ["precomposed_vector_display"],
      "not": {
        "anyOf": [
          {"required": ["source_layout"]},
          {"required": ["text_buffers"]},
          {"required": ["font_instances"]},
          {"required": ["destinations"]},
          {"required": ["pages"]}
        ]
      }
    }
  ],
  "$defs": {
    "vector_content_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ir_fingerprint",
        "ir_id",
        "media_type",
        "parser_id",
        "source_sha256"
      ],
      "properties": {
        "ir_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "ir_id": {
          "enum": ["typaxis.safe-vector-ir/1", "typaxis.safe-vector-ir/2"]
        },
        "media_type": {"enum": ["svg-safe-1", "svg-safe-2"]},
        "parser_id": {
          "enum": ["typaxis.safe-svg-parser/1", "typaxis.safe-svg-parser/2"]
        },
        "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"media_type": {"const": "svg-safe-1"}}},
          "then": {
            "properties": {
              "ir_id": {"const": "typaxis.safe-vector-ir/1"},
              "parser_id": {"const": "typaxis.safe-svg-parser/1"}
            }
          },
          "else": {
            "properties": {
              "ir_id": {"const": "typaxis.safe-vector-ir/2"},
              "parser_id": {"const": "typaxis.safe-svg-parser/2"}
            }
          }
        }
      ]
    },
    "draw_vector_baseline_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "baseline_y",
        "metric_receipt_fingerprint",
        "pen_origin_x"
      ],
      "properties": {
        "baseline": {"$ref": "common.schema.json#/$defs/nonnegative_length"},
        "baseline_y": {"$ref": "common.schema.json#/$defs/length"},
        "metric_receipt_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "pen_origin_x": {"$ref": "common.schema.json#/$defs/length"}
      }
    },
    "draw_vector_figure_caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption_flow_id", "caption_owners", "keep_caption"],
      "properties": {
        "caption_flow_id": {"$ref": "common.schema.json#/$defs/id32"},
        "caption_owners": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/id32"}
        },
        "keep_caption": {"type": "boolean"}
      }
    },
    "draw_vector_math_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_fingerprint",
        "flow_id",
        "parent_flow_id",
        "parent_position",
        "terminal",
        "terminal_receipt_fingerprint"
      ],
      "properties": {
        "flow_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "flow_id": {"$ref": "common.schema.json#/$defs/id32"},
        "parent_flow_id": {"$ref": "common.schema.json#/$defs/id32"},
        "parent_position": {"$ref": "common.schema.json#/$defs/id32"},
        "terminal": {"const": 1},
        "terminal_receipt_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "resolved_rgb8": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blue", "green", "red"],
      "properties": {
        "blue": {"type": "integer", "minimum": 0, "maximum": 255},
        "green": {"type": "integer", "minimum": 0, "maximum": 255},
        "red": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "draw_vector_v2_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_fingerprint",
        "content_key",
        "fragment_ordinal",
        "frame_index",
        "image_id",
        "ir_fingerprint",
        "kind",
        "matrix",
        "op",
        "owner",
        "page_index",
        "paint_ordinal",
        "resolved_current_color",
        "scale",
        "selected_placement_fingerprint",
        "usage_id",
        "viewport"
      ],
      "properties": {
        "baseline_metrics": {"$ref": "#/$defs/draw_vector_baseline_metrics"},
        "binding_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "content_key": {"$ref": "#/$defs/vector_content_key"},
        "figure_caption": {"$ref": "#/$defs/draw_vector_figure_caption"},
        "fragment_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "frame_index": {"$ref": "common.schema.json#/$defs/id32"},
        "image_id": {"$ref": "common.schema.json#/$defs/id32"},
        "ir_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "kind": {
          "enum": [
            "inline_vector",
            "math_vector",
            "vector_figure",
            "math_vector_block"
          ]
        },
        "math_flow": {"$ref": "#/$defs/draw_vector_math_flow"},
        "matrix": {"$ref": "common.schema.json#/$defs/affine_transform"},
        "op": {"const": "draw_vector"},
        "owner": {"$ref": "common.schema.json#/$defs/id32"},
        "page_index": {"$ref": "common.schema.json#/$defs/id32"},
        "paint_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "resolved_current_color": {"$ref": "#/$defs/resolved_rgb8"},
        "scale": {"$ref": "common.schema.json#/$defs/positive_unitless_16_16"},
        "selected_placement_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "usage_id": {"$ref": "common.schema.json#/$defs/id32"},
        "viewport": {"$ref": "common.schema.json#/$defs/rect"}
      },
      "oneOf": [
        {
          "properties": {
            "kind": {"enum": ["inline_vector", "math_vector"]}
          },
          "required": ["baseline_metrics"],
          "not": {
            "anyOf": [
              {"required": ["figure_caption"]},
              {"required": ["math_flow"]}
            ]
          }
        },
        {
          "properties": {"kind": {"const": "vector_figure"}},
          "required": ["figure_caption"],
          "not": {
            "anyOf": [
              {"required": ["baseline_metrics"]},
              {"required": ["math_flow"]}
            ]
          }
        },
        {
          "properties": {"kind": {"const": "math_vector_block"}},
          "required": ["baseline_metrics", "math_flow"],
          "not": {"required": ["figure_caption"]}
        }
      ]
    },
    "draw_vector_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "record"],
      "properties": {
        "fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "record": {"$ref": "#/$defs/draw_vector_v2_record"}
      }
    },
    "precomposed_vector_display_page_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands", "page_index"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {"$ref": "#/$defs/draw_vector_v2"}
        },
        "page_index": {"$ref": "common.schema.json#/$defs/id32"}
      }
    },
    "precomposed_vector_display_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "record"],
      "properties": {
        "fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "record": {"$ref": "#/$defs/precomposed_vector_display_page_record"}
      }
    },
    "precomposed_vector_display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted_fingerprint",
        "algorithm",
        "binding_set_fingerprint",
        "block_selected_layout_fingerprint",
        "command_count",
        "content_key_count",
        "inline_selected_layout_fingerprint",
        "limits_fingerprint",
        "package_sha256",
        "page_count",
        "page_geometry_fingerprint",
        "pages",
        "profile_fingerprint"
      ],
      "properties": {
        "admitted_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "algorithm": {"const": "typaxis.draw-vector-display/2"},
        "binding_set_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "block_selected_layout_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "command_count": {"$ref": "common.schema.json#/$defs/id32"},
        "content_key_count": {"$ref": "common.schema.json#/$defs/id32"},
        "inline_selected_layout_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "limits_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "package_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "page_count": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "page_geometry_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/precomposed_vector_display_page"}
        },
        "profile_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "layout_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_sha256", "style_page_master_sha256", "admitted_resources_sha256", "resolved_input_sha256"],
      "properties": {
        "document_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "style_page_master_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "admitted_resources_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "resolved_input_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "source_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_epoch", "state_fingerprint"],
      "properties": {
        "layout_epoch": {"$ref": "#/$defs/layout_epoch"},
        "state_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "font_instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font_instance_id",
        "font_face_id"
      ],
      "properties": {
        "font_instance_id": {
          "$ref": "common.schema.json#/$defs/id32"
        },
        "font_face_id": {
          "$ref": "common.schema.json#/$defs/id32"
        }
      }
    },
    "display_command_ops": {
      "enum": [
        "save",
        "restore",
        "concat_transform",
        "clip_path",
        "fill_path",
        "stroke_path",
        "draw_glyph_run",
        "draw_image"
      ]
    },
    "display_text_buffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_id",
        "origin",
        "utf8"
      ],
      "properties": {
        "text_id": {
          "$ref": "common.schema.json#/$defs/id32"
        },
        "origin": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "text_buffer_id"],
              "properties": {
                "kind": {"const": "parsed"},
                "text_buffer_id": {"$ref": "common.schema.json#/$defs/id32"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "key"],
              "properties": {
                "kind": {"const": "generated"},
                "key": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["generation_kind", "owner", "owner_local_ordinal"],
                  "properties": {
                    "generation_kind": {"enum": ["page_reference", "counter", "list_marker", "footnote_marker", "discretionary"]},
                    "owner": {"$ref": "common.schema.json#/$defs/id32"},
                    "owner_local_ordinal": {"$ref": "common.schema.json#/$defs/id32"}
                  }
                }
              }
            }
          ]
        },
        "utf8": {
          "type": "string"
        }
      }
    },
    "display_glyph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_gid",
        "advance_x",
        "advance_y",
        "offset_x",
        "offset_y"
      ],
      "properties": {
        "original_gid": {
          "$ref": "common.schema.json#/$defs/u16"
        },
        "advance_x": {
          "$ref": "common.schema.json#/$defs/length"
        },
        "advance_y": {
          "$ref": "common.schema.json#/$defs/length"
        },
        "offset_x": {
          "$ref": "common.schema.json#/$defs/length"
        },
        "offset_y": {
          "$ref": "common.schema.json#/$defs/length"
        }
      }
    },
    "display_cluster": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logical_ordinal",
            "glyph_start",
            "glyph_end",
            "extraction",
            "text_span"
          ],
          "properties": {
            "logical_ordinal": {
              "$ref": "common.schema.json#/$defs/id32"
            },
            "glyph_start": {
              "$ref": "common.schema.json#/$defs/id32"
            },
            "glyph_end": {
              "$ref": "common.schema.json#/$defs/id32"
            },
            "extraction": {
              "const": "unicode"
            },
            "text_span": {
              "$ref": "common.schema.json#/$defs/text_span"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logical_ordinal",
            "glyph_start",
            "glyph_end",
            "extraction"
          ],
          "properties": {
            "logical_ordinal": {
              "$ref": "common.schema.json#/$defs/id32"
            },
            "glyph_start": {
              "$ref": "common.schema.json#/$defs/id32"
            },
            "glyph_end": {
              "$ref": "common.schema.json#/$defs/id32"
            },
            "extraction": {
              "const": "artifact"
            }
          }
        }
      ]
    },
    "stroke_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "line_cap",
        "line_join",
        "miter_limit_16_16",
        "dash"
      ],
      "properties": {
        "width": {
          "$ref": "common.schema.json#/$defs/positive_length"
        },
        "line_cap": {
          "enum": [
            "butt",
            "round",
            "square"
          ]
        },
        "line_join": {
          "enum": [
            "miter",
            "round",
            "bevel"
          ]
        },
        "miter_limit_16_16": {
          "$ref": "common.schema.json#/$defs/positive_unitless_16_16"
        },
        "dash": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "array",
            "phase"
          ],
          "properties": {
            "array": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/nonnegative_length"
              }
            },
            "phase": {
              "$ref": "common.schema.json#/$defs/nonnegative_length"
            }
          }
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "save"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "restore"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "matrix"
          ],
          "properties": {
            "op": {
              "const": "concat_transform"
            },
            "matrix": {
              "$ref": "common.schema.json#/$defs/affine_transform"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "rule"
          ],
          "properties": {
            "op": {
              "const": "clip_path"
            },
            "path": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "verb",
                      "x",
                      "y"
                    ],
                    "properties": {
                      "verb": {
                        "const": "move_to"
                      },
                      "x": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y": {
                        "$ref": "common.schema.json#/$defs/length"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "verb",
                      "x",
                      "y"
                    ],
                    "properties": {
                      "verb": {
                        "const": "line_to"
                      },
                      "x": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y": {
                        "$ref": "common.schema.json#/$defs/length"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "verb",
                      "x1",
                      "y1",
                      "x2",
                      "y2",
                      "x3",
                      "y3"
                    ],
                    "properties": {
                      "verb": {
                        "const": "curve_to"
                      },
                      "x1": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y1": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "x2": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y2": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "x3": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y3": {
                        "$ref": "common.schema.json#/$defs/length"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "verb"
                    ],
                    "properties": {
                      "verb": {
                        "const": "close"
                      }
                    }
                  }
                ]
              }
            },
            "rule": {
              "enum": [
                "nonzero",
                "evenodd"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "paint",
            "rule"
          ],
          "properties": {
            "op": {
              "const": "fill_path"
            },
            "path": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "verb",
                      "x",
                      "y"
                    ],
                    "properties": {
                      "verb": {
                        "const": "move_to"
                      },
                      "x": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y": {
                        "$ref": "common.schema.json#/$defs/length"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "verb",
                      "x",
                      "y"
                    ],
                    "properties": {
                      "verb": {
                        "const": "line_to"
                      },
                      "x": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y": {
                        "$ref": "common.schema.json#/$defs/length"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "verb",
                      "x1",
                      "y1",
                      "x2",
                      "y2",
                      "x3",
                      "y3"
                    ],
                    "properties": {
                      "verb": {
                        "const": "curve_to"
                      },
                      "x1": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y1": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "x2": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y2": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "x3": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y3": {
                        "$ref": "common.schema.json#/$defs/length"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "verb"
                    ],
                    "properties": {
                      "verb": {
                        "const": "close"
                      }
                    }
                  }
                ]
              }
            },
            "paint": {
              "$ref": "#/$defs/paint"
            },
            "rule": {
              "enum": [
                "nonzero",
                "evenodd"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "path",
            "paint",
            "stroke"
          ],
          "properties": {
            "op": {
              "const": "stroke_path"
            },
            "path": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "verb",
                      "x",
                      "y"
                    ],
                    "properties": {
                      "verb": {
                        "const": "move_to"
                      },
                      "x": {
                        "$ref": "common.schema.json#/$defs/length"
                      },
                      "y": {
                        "$ref": "common.schema.json#/$defs/length"
                      }
                    }
