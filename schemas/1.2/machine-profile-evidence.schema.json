{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.typaxis.invalid/1.2/machine-profile-evidence.schema.json",
  "title": "Typaxis Machine Profile Host Evidence 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifacts",
    "binary",
    "checks",
    "contract",
    "fixture",
    "host",
    "reproducibility",
    "result",
    "source",
    "tools"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "binary": {"$ref": "#/$defs/binary"},
    "checks": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/check"}
    },
    "contract": {"const": "typaxis.machine-profile-evidence/1"},
    "fixture": {"$ref": "#/$defs/fixture"},
    "host": {"$ref": "#/$defs/host"},
    "reproducibility": {"$ref": "#/$defs/reproducibility"},
    "result": {"enum": ["failed", "passed"]},
    "source": {"$ref": "#/$defs/source"},
    "tools": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/tool"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "kind", "sha256"],
      "properties": {
        "bytes": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "kind": {
          "enum": ["capabilities", "diagnostics", "manifest", "pdf", "trace"]
        },
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "version"],
      "properties": {
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result"],
      "properties": {
        "detail": {"type": "string"},
        "name": {
          "enum": [
            "artifact_byte_identity",
            "build_package_run_1",
            "build_package_run_2",
            "capabilities_profile_closure",
            "capabilities_schema",
            "check_package",
            "clean_binary_build",
            "diagnostics_schema",
            "external_page_count",
            "external_poppler_text",
            "external_mupdf_raster",
            "manifest_schema",
            "machine_reproducibility",
            "profile_receipt_closure",
            "trace_schema"
          ]
        },
        "result": {"enum": ["failed", "passed"]}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_sha256", "fixture_id", "resources"],
      "properties": {
        "expected_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "fixture_id": {"type": "string", "minLength": 1},
        "resources": {
          "type": "array",
          "items": {"$ref": "#/$defs/resource"}
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "os", "target_triple"],
      "properties": {
        "arch": {"type": "string", "minLength": 1},
        "os": {"enum": ["linux", "macos"]},
        "target_triple": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "binary_sha256",
        "binary_version",
        "revision",
        "source_snapshot_sha256"
      ],
      "properties": {
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["capabilities", "diagnostics", "manifest", "pdf", "trace"],
          "properties": {
            "capabilities": {"$ref": "common.schema.json#/$defs/sha256"},
            "diagnostics": {"$ref": "common.schema.json#/$defs/sha256"},
            "manifest": {"$ref": "common.schema.json#/$defs/sha256"},
            "pdf": {"$ref": "common.schema.json#/$defs/sha256"},
            "trace": {"$ref": "common.schema.json#/$defs/sha256"}
          }
        },
        "binary_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "binary_version": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/revision"},
        "source_snapshot_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256", "uri"],
      "properties": {
        "bytes": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "uri": {"type": "string", "minLength": 1}
      }
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargo_lock_sha256", "revision", "snapshot_sha256"],
      "properties": {
        "cargo_lock_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "revision": {"$ref": "#/$defs/revision"},
        "snapshot_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "version"],
      "properties": {
        "name": {
          "enum": ["cargo", "mutool", "pdfinfo", "pdftotext", "python", "rustc"]
        },
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
