{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.typaxis.invalid/1.4/machine-block-style-manifest.schema.json",
  "title": "Typaxis Typed Block Style Manifest Fact 1.4",
  "description": "Contract-1.4 selected-state projection retaining the MI2-03 fact shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm",
    "available_inline_size",
    "block_kind",
    "contract",
    "effective_space_after",
    "effective_space_before",
    "end_indent",
    "frame_inline_size",
    "keep_caption",
    "keep_with_next",
    "logical_end_alignment_space",
    "logical_start_alignment_space",
    "owner_node_id",
    "package_sha256",
    "page_break_before",
    "paint_inline_size",
    "paint_left_inset",
    "pdf_observation_sha256",
    "registry_version",
    "start_indent"
  ],
  "properties": {
    "algorithm": {
      "const": "typaxis.machine-block-style-manifest/1"
    },
    "available_inline_size": {
      "$ref": "common.schema.json#/$defs/positive_length"
    },
    "block_kind": {
      "enum": [
        "paragraph",
        "heading",
        "list",
        "figure",
        "page_break"
      ]
    },
    "contract": {
      "$ref": "common.schema.json#/$defs/contract"
    },
    "effective_space_after": {
      "$ref": "common.schema.json#/$defs/nonnegative_length"
    },
    "effective_space_before": {
      "$ref": "common.schema.json#/$defs/nonnegative_length"
    },
    "end_indent": {
      "$ref": "common.schema.json#/$defs/nonnegative_length"
    },
    "frame_inline_size": {
      "$ref": "common.schema.json#/$defs/positive_length"
    },
    "keep_caption": {
      "type": "boolean"
    },
    "keep_with_next": {
      "type": "boolean"
    },
    "logical_end_alignment_space": {
      "$ref": "common.schema.json#/$defs/nonnegative_length"
    },
    "logical_start_alignment_space": {
      "$ref": "common.schema.json#/$defs/nonnegative_length"
    },
    "owner_node_id": {
      "$ref": "common.schema.json#/$defs/id32"
    },
    "package_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "page_break_before": {
      "type": "boolean"
    },
    "paint_inline_size": {
      "$ref": "common.schema.json#/$defs/positive_length"
    },
    "paint_left_inset": {
      "$ref": "common.schema.json#/$defs/nonnegative_length"
    },
    "pdf_observation_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "registry_version": {
      "const": "typaxis.basic-block-style-registry/1"
    },
    "start_indent": {
      "$ref": "common.schema.json#/$defs/nonnegative_length"
    }
  }
}
