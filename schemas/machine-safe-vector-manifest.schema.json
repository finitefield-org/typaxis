{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.typaxis.invalid/1.4/machine-safe-vector-manifest.schema.json",
  "title": "Typaxis SafeVector Manifest 1.4",
  "description": "Public MI4 SafeVector declaration, admission, layout, Display, Form-plan, and PDF closure projection. Version 2 unifies existing Figure and producer-composed vector usage.",
  "oneOf": [
    {"$ref": "#/$defs/v1_manifest"},
    {"$ref": "#/$defs/v2_manifest"}
  ],
  "$defs": {
    "v1_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted_fingerprint",
        "algorithm",
        "declared_media_fingerprint",
        "display_fingerprint",
        "form_plans_fingerprint",
        "limits_fingerprint",
        "package_fingerprint",
        "pdf_fingerprint",
        "pdf_sha256",
        "profile_fingerprint",
        "resources",
        "selected_layout_fingerprint"
      ],
      "properties": {
        "admitted_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "algorithm": {"const": "typaxis.safe-vector-manifest/1"},
        "declared_media_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "display_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "form_plans_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "limits_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "package_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "pdf_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "pdf_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "profile_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "resources": {
          "type": "array",
          "items": {"$ref": "#/$defs/resource"}
        },
        "selected_layout_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "v2_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "contract", "fingerprints", "placement_count", "resources"],
      "properties": {
        "algorithm": {"const": "typaxis.safe-vector-manifest/2"},
        "contract": {"const": "typaxis.contract/1.4"},
        "fingerprints": {"$ref": "#/$defs/v2_fingerprints"},
        "placement_count": {"$ref": "common.schema.json#/$defs/id32"},
        "resources": {
          "type": "array",
          "items": {"$ref": "#/$defs/v2_resource"}
        }
      }
    },
    "v2_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted_sha256",
        "candidate_registry_sha256",
        "display_sha256",
        "final_writer_sha256",
        "form_plans_sha256",
        "limits_sha256",
        "package_sha256",
        "pdf_closure_sha256",
        "pdf_contribution_sha256",
        "pdf_sha256",
        "profile_sha256"
      ],
      "properties": {
        "admitted_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "candidate_registry_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "display_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "final_writer_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "form_plans_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "limits_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "package_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "pdf_closure_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "pdf_contribution_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "pdf_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "profile_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "v2_content_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ir_fingerprint", "ir_id", "media_type", "parser_id", "source_sha256"],
      "properties": {
        "ir_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "ir_id": {"enum": ["typaxis.safe-vector-ir/1", "typaxis.safe-vector-ir/2"]},
        "media_type": {"enum": ["svg-safe-1", "svg-safe-2"]},
        "parser_id": {"enum": ["typaxis.safe-svg-parser/1", "typaxis.safe-svg-parser/2"]},
        "source_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "v2_producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_id", "engine_version", "rules_version"],
      "properties": {
        "engine_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\u0020-\\u007E]+$"},
        "engine_version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\u0020-\\u007E]+$"},
        "rules_version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\u0020-\\u007E]+$"}
      }
    },
    "v2_alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission_allocation_charge",
        "admission_attestation_fingerprint",
        "admitted_sha256",
        "expected_sha256",
        "image_id",
        "placement_count",
        "uri",
        "usage_fingerprints"
      ],
      "properties": {
        "admission_allocation_charge": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "admission_attestation_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "admitted_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "expected_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "image_id": {"$ref": "common.schema.json#/$defs/id32"},
        "placement_count": {"$ref": "common.schema.json#/$defs/id32"},
        "provenance": {"$ref": "#/$defs/v2_producer"},
        "uri": {"$ref": "common.schema.json#/$defs/portable_relative_path"},
        "usage_fingerprints": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/sha256"}
        }
      }
    },
    "v2_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advance", "ascent", "baseline", "descent", "origin_x", "viewport_height", "viewport_width"],
      "properties": {
        "advance": {"$ref": "common.schema.json#/$defs/positive_length"},
        "ascent": {"$ref": "common.schema.json#/$defs/positive_length"},
        "baseline": {"$ref": "common.schema.json#/$defs/nonnegative_length"},
        "descent": {"$ref": "common.schema.json#/$defs/nonnegative_length"},
        "origin_x": {"$ref": "common.schema.json#/$defs/length"},
        "viewport_height": {"$ref": "common.schema.json#/$defs/positive_length"},
        "viewport_width": {"$ref": "common.schema.json#/$defs/positive_length"}
      }
    },
    "v2_rect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"$ref": "common.schema.json#/$defs/length"},
        {"$ref": "common.schema.json#/$defs/length"},
        {"$ref": "common.schema.json#/$defs/positive_length"},
        {"$ref": "common.schema.json#/$defs/positive_length"}
      ],
      "items": false
    },
    "v2_matrix": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "common.schema.json#/$defs/safe_integer"},
        {"$ref": "common.schema.json#/$defs/safe_integer"},
        {"$ref": "common.schema.json#/$defs/safe_integer"},
        {"$ref": "common.schema.json#/$defs/safe_integer"},
        {"$ref": "common.schema.json#/$defs/length"},
        {"$ref": "common.schema.json#/$defs/length"}
      ],
      "items": false
    },
    "v2_block_style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alignment", "end_indent", "fingerprint", "keep_with_next", "space_after", "space_before", "start_indent"],
      "properties": {
        "alignment": {"enum": ["center", "end", "start"]},
        "end_indent": {"$ref": "common.schema.json#/$defs/nonnegative_length"},
        "fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "keep_with_next": {"type": "boolean"},
        "space_after": {"$ref": "common.schema.json#/$defs/nonnegative_length"},
        "space_before": {"$ref": "common.schema.json#/$defs/nonnegative_length"},
        "start_indent": {"$ref": "common.schema.json#/$defs/nonnegative_length"}
      }
    },
    "v2_math_flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "flow_fingerprint", "flow_id", "parent_flow_id", "parent_position", "terminal", "terminal_receipt_fingerprint"],
      "properties": {
        "algorithm": {"const": "typaxis.math-vector-flow/1"},
        "flow_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "flow_id": {"$ref": "common.schema.json#/$defs/id32"},
        "parent_flow_id": {"$ref": "common.schema.json#/$defs/id32"},
        "parent_position": {"$ref": "common.schema.json#/$defs/id32"},
        "terminal": {"const": 1},
        "terminal_receipt_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "v2_placement_common": {
      "type": "object",
      "required": [
        "alternative_sha256",
        "display_command_fingerprint",
        "fragment_ordinal",
        "frame_index",
        "image_id",
        "kind",
        "language",
        "matrix",
        "node_id",
        "page_index",
        "paint_ordinal",
        "pdf_content_object_number",
        "pdf_form_object_number",
        "pdf_page_object_number",
        "pdf_use_fingerprint",
        "scale",
        "selected_placement_fingerprint",
        "source_span",
        "usage_id",
        "viewport"
      ],
      "properties": {
        "alternative_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "display_command_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "fragment_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "frame_index": {"$ref": "common.schema.json#/$defs/id32"},
        "image_id": {"$ref": "common.schema.json#/$defs/id32"},
        "kind": {"enum": ["figure", "inline_vector", "math_vector", "math_vector_block", "vector_figure"]},
        "language": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"},
        "matrix": {"$ref": "#/$defs/v2_matrix"},
        "node_id": {"$ref": "common.schema.json#/$defs/id32"},
        "page_index": {"$ref": "common.schema.json#/$defs/id32"},
        "paint_ordinal": {"$ref": "common.schema.json#/$defs/id32"},
        "pdf_content_object_number": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "pdf_form_object_number": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "pdf_page_object_number": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "pdf_use_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "scale": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "selected_placement_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "source_span": {"$ref": "common.schema.json#/$defs/source_span"},
        "usage_id": {"$ref": "common.schema.json#/$defs/id32"},
        "viewport": {"$ref": "#/$defs/v2_rect"}
      }
    },
    "v2_figure_placement": {
      "type": "object",
      "required": ["kind", "placement"],
      "properties": {
        "kind": {"const": "figure"},
        "placement": {"enum": ["block", "float"]}
      }
    },
    "v2_inline_vector_placement": {
      "type": "object",
      "required": ["authored_actual_text_sha256", "binding_fingerprint", "kind", "metric_receipt_fingerprint", "metrics", "spacing_after", "spacing_before"],
      "properties": {
        "authored_actual_text_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "binding_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "kind": {"const": "inline_vector"},
        "metric_receipt_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "metrics": {"$ref": "#/$defs/v2_metrics"},
        "spacing_after": {"$ref": "common.schema.json#/$defs/nonnegative_length"},
        "spacing_before": {"$ref": "common.schema.json#/$defs/nonnegative_length"}
      }
    },
    "v2_math_vector_placement": {
      "type": "object",
      "required": ["binding_fingerprint", "kind", "metric_receipt_fingerprint", "metrics", "spacing_after", "spacing_before"],
      "properties": {
        "binding_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "kind": {"const": "math_vector"},
        "metric_receipt_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "metrics": {"$ref": "#/$defs/v2_metrics"},
        "spacing_after": {"$ref": "common.schema.json#/$defs/nonnegative_length"},
        "spacing_before": {"$ref": "common.schema.json#/$defs/nonnegative_length"}
      }
    },
    "v2_vector_figure_placement": {
      "type": "object",
      "required": ["binding_fingerprint", "block_style", "keep_caption", "kind", "metric_receipt_fingerprint"],
      "properties": {
        "binding_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "block_style": {"$ref": "#/$defs/v2_block_style"},
        "keep_caption": {"type": "boolean"},
        "kind": {"const": "vector_figure"},
        "metric_receipt_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "v2_math_block_placement": {
      "type": "object",
      "required": ["binding_fingerprint", "block_style", "kind", "math_flow", "metric_receipt_fingerprint", "metrics"],
      "properties": {
        "binding_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "block_style": {"$ref": "#/$defs/v2_block_style"},
        "kind": {"const": "math_vector_block"},
        "math_flow": {"$ref": "#/$defs/v2_math_flow"},
        "metric_receipt_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "metrics": {"$ref": "#/$defs/v2_metrics"}
      }
    },
    "v2_placement": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/v2_placement_common"},
        {
          "oneOf": [
            {"$ref": "#/$defs/v2_figure_placement"},
            {"$ref": "#/$defs/v2_inline_vector_placement"},
            {"$ref": "#/$defs/v2_math_vector_placement"},
            {"$ref": "#/$defs/v2_math_block_placement"},
            {"$ref": "#/$defs/v2_vector_figure_placement"}
          ]
        }
      ]
    },
    "v2_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aliases",
        "allocation_charge",
        "allocation_charge_id",
        "content_key",
        "form_plan_fingerprint",
        "intrinsic_height",
        "intrinsic_width",
        "ir_fingerprint_id",
        "ir_id",
        "parser_id",
        "pdf_form_object_number",
        "pdf_resource_name",
        "placements",
        "svg_byte_length",
        "total_placement_count",
        "view_box"
      ],
      "properties": {
        "aliases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/v2_alias"}},
        "allocation_charge": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "allocation_charge_id": {"enum": ["typaxis.safe-vector-allocation-charge/1", "typaxis.safe-vector-allocation-charge/2"]},
        "content_key": {"$ref": "#/$defs/v2_content_key"},
        "form_plan_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "intrinsic_height": {"$ref": "common.schema.json#/$defs/positive_length"},
        "intrinsic_width": {"$ref": "common.schema.json#/$defs/positive_length"},
        "ir_fingerprint_id": {"enum": ["typaxis.safe-vector-ir-fingerprint/1", "typaxis.safe-vector-ir-fingerprint/2"]},
        "ir_id": {"enum": ["typaxis.safe-vector-ir/1", "typaxis.safe-vector-ir/2"]},
        "parser_id": {"enum": ["typaxis.safe-svg-parser/1", "typaxis.safe-svg-parser/2"]},
        "pdf_form_object_number": {"$ref": "#/$defs/nullable_id32"},
        "pdf_resource_name": {"$ref": "#/$defs/nullable_resource_name"},
        "placements": {"type": "array", "items": {"$ref": "#/$defs/v2_placement"}},
        "svg_byte_length": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "total_placement_count": {"$ref": "common.schema.json#/$defs/id32"},
        "view_box": {"$ref": "#/$defs/v2_rect"}
      },
      "allOf": [
        {
          "if": {"properties": {"placements": {"maxItems": 0}}, "required": ["placements"]},
          "then": {
            "properties": {
              "form_plan_fingerprint": {"type": "null"},
              "pdf_form_object_number": {"type": "null"},
              "pdf_resource_name": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "form_plan_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
              "pdf_form_object_number": {"type": "integer", "minimum": 1, "maximum": 4294967295},
              "pdf_resource_name": {"type": "string", "pattern": "^V(?:0|[1-9][0-9]*)$"}
            }
          }
        },
        {
          "if": {"properties": {"content_key": {"properties": {"media_type": {"const": "svg-safe-1"}}, "required": ["media_type"]}}, "required": ["content_key"]},
          "then": {
            "properties": {
              "allocation_charge_id": {"const": "typaxis.safe-vector-allocation-charge/1"},
              "content_key": {"properties": {"ir_id": {"const": "typaxis.safe-vector-ir/1"}, "parser_id": {"const": "typaxis.safe-svg-parser/1"}}},
              "ir_fingerprint_id": {"const": "typaxis.safe-vector-ir-fingerprint/1"},
              "ir_id": {"const": "typaxis.safe-vector-ir/1"},
              "parser_id": {"const": "typaxis.safe-svg-parser/1"},
              "aliases": {"items": {"not": {"required": ["provenance"]}}},
              "placements": {
                "items": {
                  "properties": {
                    "kind": {"enum": ["figure", "inline_vector", "vector_figure"]}
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "allocation_charge_id": {"const": "typaxis.safe-vector-allocation-charge/2"},
              "content_key": {"properties": {"ir_id": {"const": "typaxis.safe-vector-ir/2"}, "parser_id": {"const": "typaxis.safe-svg-parser/2"}}},
              "ir_fingerprint_id": {"const": "typaxis.safe-vector-ir-fingerprint/2"},
              "ir_id": {"const": "typaxis.safe-vector-ir/2"},
              "parser_id": {"const": "typaxis.safe-svg-parser/2"},
              "aliases": {
                "items": {
                  "required": ["provenance"],
                  "properties": {"expected_sha256": {"$ref": "common.schema.json#/$defs/sha256"}}
                }
              },
              "placements": {
                "items": {
                  "properties": {
                    "kind": {"enum": ["inline_vector", "math_vector", "math_vector_block", "vector_figure"]}
                  }
                }
              }
            }
          }
        }
      ]
    },
    "nullable_sha256": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/sha256"}
      ]
    },
    "nullable_id32": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/id32"}
      ]
    },
    "nullable_resource_name": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^V(?:0|[1-9][0-9]*)$"}
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alternative_sha256",
        "bounds",
        "display_command_fingerprint",
        "occurrence",
        "owner",
        "page_index",
        "pdf_content_object_number",
        "pdf_page_object_number",
        "scale",
        "selected_placement_fingerprint"
      ],
      "properties": {
        "alternative_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "bounds": {"$ref": "common.schema.json#/$defs/rect"},
        "display_command_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "occurrence": {"$ref": "common.schema.json#/$defs/id32"},
        "owner": {"$ref": "common.schema.json#/$defs/id32"},
        "page_index": {"$ref": "common.schema.json#/$defs/id32"},
        "pdf_content_object_number": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "pdf_page_object_number": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "scale": {"type": "integer", "minimum": 1, "maximum": 65536},
        "selected_placement_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admitted_sha256",
        "allocation_charge",
        "allocation_charge_algorithm",
        "attested_media_kind",
        "declared_media_type",
        "form_plan_fingerprint",
        "image_id",
        "intrinsic_height",
        "intrinsic_width",
        "ir_algorithm",
        "ir_fingerprint",
        "ir_fingerprint_algorithm",
        "pdf_form_object_number",
        "pdf_resource_name",
        "safe_svg_parser",
        "uri",
        "usages"
      ],
      "properties": {
        "admitted_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "allocation_charge": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "allocation_charge_algorithm": {"const": "typaxis.safe-vector-allocation-charge/1"},
        "attested_media_kind": {"const": "svg-safe-1"},
        "declared_media_type": {"const": "svg-safe-1"},
        "form_plan_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "image_id": {"$ref": "common.schema.json#/$defs/id32"},
        "intrinsic_height": {"$ref": "common.schema.json#/$defs/positive_length"},
        "intrinsic_width": {"$ref": "common.schema.json#/$defs/positive_length"},
        "ir_algorithm": {"const": "typaxis.safe-vector-ir/1"},
        "ir_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "ir_fingerprint_algorithm": {"const": "typaxis.safe-vector-ir-fingerprint/1"},
        "pdf_form_object_number": {"$ref": "#/$defs/nullable_id32"},
        "pdf_resource_name": {"$ref": "#/$defs/nullable_resource_name"},
        "safe_svg_parser": {"const": "typaxis.safe-svg-parser/1"},
        "uri": {"$ref": "common.schema.json#/$defs/portable_relative_path"},
        "usages": {
          "type": "array",
          "items": {"$ref": "#/$defs/usage"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"usages": {"maxItems": 0}}},
          "then": {
            "properties": {
              "form_plan_fingerprint": {"type": "null"},
              "pdf_form_object_number": {"type": "null"},
              "pdf_resource_name": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "form_plan_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
              "pdf_form_object_number": {"type": "integer", "minimum": 1, "maximum": 4294967295},
              "pdf_resource_name": {"type": "string", "pattern": "^V(?:0|[1-9][0-9]*)$"}
            }
          }
        }
      ]
    }
  }
}
