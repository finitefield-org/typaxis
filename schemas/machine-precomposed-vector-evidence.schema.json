{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.typaxis.invalid/1.4/machine-precomposed-vector-evidence.schema.json",
  "title": "Typaxis Precomposed Vector Host Evidence 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_set_sha256", "artifacts", "binary", "checks", "contract", "external", "fixture", "host", "production", "result", "source", "tools", "verifier"],
  "properties": {
    "artifact_set_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "artifacts": {"type": "array", "minItems": 21, "maxItems": 21, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "binary": {"$ref": "#/$defs/binary"},
    "checks": {"type": "array", "minItems": 28, "maxItems": 28, "uniqueItems": true, "items": {"$ref": "#/$defs/check"}},
    "contract": {"const": "typaxis.machine-precomposed-vector-evidence/2"},
    "external": {"$ref": "#/$defs/external"},
    "fixture": {"$ref": "#/$defs/fixture"},
    "host": {"$ref": "#/$defs/host"},
    "production": {"$ref": "#/$defs/production"},
    "result": {"const": "passed"},
    "source": {"$ref": "#/$defs/source"},
    "tools": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"$ref": "#/$defs/mutool"}, {"$ref": "#/$defs/pdfinfo"},
        {"$ref": "#/$defs/pdftotext"}, {"$ref": "#/$defs/verapdf_tool"}
      ],
      "items": false
    },
    "verifier": {"$ref": "#/$defs/verifier"}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["bytes", "name", "sha256"],
      "properties": {
        "bytes": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "name": {"enum": ["block-layout-trace.json", "book-navigation-manifest.json", "build-manifest-vector.json", "corpus-admission.json", "corpus-display.json", "corpus-output.pdf", "dedupe-ten-use.pdf", "dedupe-two-alias.pdf", "display-v2.json", "effective-document-package.json", "figure-build-manifest-vector.json", "figure-output.pdf", "inline-layout-trace.json", "math-vector-manifest.json", "output.pdf", "pdf-observation.json", "phase-receipts.json", "safe-vector-manifest.json", "tagged-pdf-expectation.json", "tagged-pdf-manifest.json", "verification.json"]},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "binary": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "version"],
      "properties": {"sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "version": {"const": "typaxis 0.1.0"}}
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["name", "result"],
      "properties": {
        "detail": {"type": "string", "minLength": 1},
        "name": {"enum": ["artifact_index", "block_atomicity", "corpus_admission", "corpus_coverage", "corpus_pdf", "dedupe_alias", "dedupe_ten_use", "display_manifest_pdf_closure", "effective_package_identity", "external_mupdf_multi_dpi", "external_poppler_page_text", "external_vector_operator", "inline_baseline", "inline_line_metrics", "language_structure", "legacy_figure_closure", "manifest_dependency", "matterhorn_1_02", "negative_fixture_coverage", "pdf_accessible_text", "pdf_structure_v2", "pdf_vector_only", "phase_order", "production_resource_set_v2", "public_surface_isolation", "publication_capability_projection", "resource_hashes", "verapdf_ua1"]},
        "result": {"const": "passed"}
      }
    },
    "differential": {
      "type": "object", "additionalProperties": false,
      "required": ["extracted_text_sha256", "page_count", "render_dpis", "render_sha256"],
      "properties": {
        "extracted_text_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "page_count": {"const": 2}, "render_dpis": {"const": [72, 144, 288]},
        "render_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "external": {
      "type": "object", "additionalProperties": false,
      "required": ["differential", "matterhorn", "pdf_sha256", "structure", "tool_policy_sha256", "verapdf"],
      "properties": {
        "differential": {"$ref": "#/$defs/differential"}, "matterhorn": {"$ref": "#/$defs/matterhorn"},
        "pdf_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "structure": {"$ref": "#/$defs/vector_structure"}, "tool_policy_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "verapdf": {"$ref": "#/$defs/verapdf_result"}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["assertion_traceability_sha256", "cases_sha256", "expected_sha256", "fixture_id", "fragment_text_set_sha256", "fragments_sha256", "negative_sha256", "package_sha256", "resources_sha256", "source_set_sha256", "tex_set_sha256"],
      "properties": {
        "assertion_traceability_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "cases_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "expected_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "fixture_id": {"const": "mi4-v18.precomposed-vector-combined"},
        "fragment_text_set_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "fragments_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "negative_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "package_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "resources_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "source_set_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "tex_set_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "host": {
      "type": "object", "additionalProperties": false, "required": ["arch", "os", "target_triple"],
      "properties": {"arch": {"type": "string", "minLength": 1}, "os": {"enum": ["linux", "macos"]}, "target_triple": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}}
    },
    "matterhorn": {
      "type": "object", "additionalProperties": false,
      "required": ["assessment_sha256", "human_item_count", "item_count", "machine_item_count", "not_applicable_count", "passed_count"],
      "properties": {
        "assessment_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "human_item_count": {"const": 47},
        "item_count": {"const": 136}, "machine_item_count": {"const": 87},
        "not_applicable_count": {"const": 37}, "passed_count": {"const": 99}
      }
    },
    "mutool": {"allOf": [{"$ref": "#/$defs/tool"}, {"properties": {"name": {"const": "mutool"}, "version": {"const": "mutool version 1.28.2"}}}]},
    "pdfinfo": {"allOf": [{"$ref": "#/$defs/tool"}, {"properties": {"name": {"const": "pdfinfo"}, "version": {"const": "pdfinfo version 26.08.0"}}}]},
    "pdftotext": {"allOf": [{"$ref": "#/$defs/tool"}, {"properties": {"name": {"const": "pdftotext"}, "version": {"const": "pdftotext version 26.08.0"}}}]},
    "production": {
      "type": "object", "additionalProperties": false,
      "required": ["capabilities_sha256", "expectation_sha256", "font_resources", "readiness_sha256", "resource_count", "resource_ledger_sha256", "resources"],
      "properties": {
        "capabilities_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "expectation_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "font_resources": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/resource"}},
        "readiness_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "resource_count": {"const": 73},
        "resource_ledger_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "resources": {"type": "array", "minItems": 73, "maxItems": 73, "uniqueItems": true, "items": {"$ref": "#/$defs/resource"}}
      }
    },
    "resource": {
      "type": "object", "additionalProperties": false, "required": ["bytes", "sha256", "uri"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "uri": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\).+$"}
      }
    },
    "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["cargo_lock_sha256", "revision", "snapshot_sha256"],
      "properties": {"cargo_lock_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "revision": {"$ref": "#/$defs/revision"}, "snapshot_sha256": {"$ref": "common.schema.json#/$defs/sha256"}}
    },
    "tool": {
      "type": "object", "additionalProperties": false, "required": ["executable_sha256", "name", "payload_sha256", "version"],
      "properties": {
        "executable_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "name": {"enum": ["mutool", "pdfinfo", "pdftotext", "verapdf"]},
        "payload_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "version": {"type": "string", "minLength": 1}
      }
    },
    "vector_structure": {
      "type": "object", "additionalProperties": false,
      "required": ["do_count", "ext_g_state_count", "form_count", "page_root_y_flip_count", "structure_sha256"],
      "properties": {
        "do_count": {"const": 4}, "ext_g_state_count": {"const": 1}, "form_count": {"const": 1}, "page_root_y_flip_count": {"const": 2},
        "structure_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "verapdf_result": {
      "type": "object", "additionalProperties": false,
      "required": ["failed_checks", "failed_rules", "flavour", "passed_checks", "passed_rules", "profile", "version"],
      "properties": {
        "failed_checks": {"const": 0}, "failed_rules": {"const": 0}, "flavour": {"const": "ua1"},
        "passed_checks": {"const": 172}, "passed_rules": {"const": 106},
        "profile": {"const": "PDF/UA-1 validation profile"}, "version": {"const": "1.30.2"}
      }
    },
    "verapdf_tool": {"allOf": [{"$ref": "#/$defs/tool"}, {"properties": {"name": {"const": "verapdf"}, "payload_sha256": {"const": "e12acf5b4dd4d03b4e3abaf88ddb0ecccfc914afe65299f50681853d6ce5b63b"}, "version": {"const": "veraPDF 1.30.2"}}}]},
    "verifier": {
      "type": "object", "additionalProperties": false, "required": ["id", "sha256", "version"],
      "properties": {"id": {"const": "typaxis.verify-precomposed-vector/2"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "version": {"const": "2"}}
    }
  }
}
