{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.typaxis.invalid/1.4/build-manifest.schema.json",
  "title": "Typaxis Build Manifest 1.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "status",
    "deterministic",
    "engine",
    "data_versions",
    "config_sha256",
    "input_profile",
    "package_input",
    "inputs",
    "fonts",
    "images",
    "pdf_profile",
    "stream_compression",
    "layout",
    "output"
  ],
  "properties": {
    "advanced_pagination": {
      "$ref": "machine-advanced-pagination-manifest.schema.json"
    },
    "contract": {
      "$ref": "common.schema.json#/$defs/contract"
    },
    "status": {
      "enum": [
        "built",
        "failed"
      ]
    },
    "deterministic": {
      "const": true
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "rust_version",
        "git_commit"
      ],
      "properties": {
        "name": {
          "const": "typaxis"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rust_version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "data_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unicode",
        "japanese_line_break",
        "shaper_backend",
        "shaper_version"
      ],
      "properties": {
        "unicode": {
          "const": "16.0.0"
        },
        "japanese_line_break": {
          "const": "typaxis-jlreq-horizontal/1.0.0"
        },
        "shaper_backend": {
          "const": "typaxis-reference-shaper"
        },
        "shaper_version": {
          "const": "0.1.0"
        }
      }
    },
    "config_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "input_profile": {
      "enum": [
        "typaxis.machine-pdf/basic-document-1",
        "typaxis.machine-pdf/columns-1",
        "typaxis.machine-pdf/float-1",
        "typaxis.machine-pdf/footnote-1",
        "typaxis.machine-pdf/header-footer-1",
        "typaxis.machine-pdf/paragraph-1",
        "typaxis.machine-pdf/production-book-1",
        "typaxis.machine-pdf/table-1",
        "typaxis.reference-source/1"
      ]
    },
    "package_input": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/package_input_record"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file_record"
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/font_record"},
          {"$ref": "#/$defs/production_font_record"}
        ]
      }
    },
    "images": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/image_record"},
          {"$ref": "#/$defs/production_image_record"}
        ]
      }
    },
    "pdf_profile": {
      "const": "pdf-1.7-classic-xref"
    },
    "stream_compression": {
      "enum": [
        "flate",
        "none"
      ]
    },
    "layout": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/layout_summary"
        }
      ]
    },
    "output": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/output_record"
        }
      ]
    },
    "footnote_layout": {
      "$ref": "machine-footnote-manifest.schema.json"
    },
    "table_layouts": {
      "type": "array",
      "items": {
        "$ref": "machine-table-manifest.schema.json"
      }
    },
    "book_navigation_manifest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "machine-book-navigation-manifest.schema.json#/$defs/v2_manifest"}
      ]
    },
    "book_navigation_manifest_fingerprint": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/sha256"}
      ]
    },
    "math_vector_manifest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "machine-math-vector-manifest.schema.json"}
      ]
    },
    "math_vector_manifest_fingerprint": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/sha256"}
      ]
    },
    "safe_vector_manifest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "machine-safe-vector-manifest.schema.json#/$defs/v2_manifest"}
      ]
    },
    "safe_vector_manifest_fingerprint": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/sha256"}
      ]
    },
    "tagged_pdf_manifest": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "machine-accessibility-manifest.schema.json#/$defs/v2_manifest"}
      ]
    },
    "tagged_pdf_manifest_fingerprint": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/sha256"}
      ]
    }
  },
  "$defs": {
    "layout_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "pass_count",
        "selected_state",
        "final_fingerprint",
        "fallback_policy",
        "flow_registry_sha256",
        "profile_receipt_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "converged",
            "cycle_fallback",
            "max_pass_fallback"
          ]
        },
        "pass_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "selected_state": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "final_fingerprint": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "flow_registry_sha256": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "profile_receipt_sha256": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "fallback_policy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "const": "lowest_cost_then_earliest"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "converged"
              }
            }
          },
          "then": {
            "properties": {
              "fallback_policy": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "cycle_fallback",
                  "max_pass_fallback"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "fallback_policy": {
                "const": "lowest_cost_then_earliest"
              }
            }
          }
        }
      ]
    },
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "bytes",
        "sha256"
      ],
      "properties": {
        "uri": {
          "$ref": "common.schema.json#/$defs/portable_relative_path"
        },
        "bytes": {
          "$ref": "common.schema.json#/$defs/nonnegative_safe_integer"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "package_input_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "canonical_sha256",
        "contract",
        "profile_receipt_sha256",
        "sha256",
        "uri"
      ],
      "properties": {
        "bytes": {
          "$ref": "common.schema.json#/$defs/positive_safe_integer"
        },
        "canonical_sha256": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract": {
          "oneOf": [
            {
              "enum": [
                "typaxis.contract/1.0",
                "typaxis.contract/1.1",
                "typaxis.contract/1.2",
                "typaxis.contract/1.3",
                "typaxis.contract/1.4"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_receipt_sha256": {
          "oneOf": [
            {"$ref": "common.schema.json#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "uri": {
          "$ref": "common.schema.json#/$defs/portable_relative_path"
        }
      },
      "oneOf": [
        {
          "properties": {
            "canonical_sha256": {
              "type": "null"
            },
            "contract": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "canonical_sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "contract": {
              "enum": [
                "typaxis.contract/1.0",
                "typaxis.contract/1.1",
                "typaxis.contract/1.2",
                "typaxis.contract/1.3",
                "typaxis.contract/1.4"
              ]
            }
          }
        }
      ]
    },
    "output_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sink",
        "bytes",
        "sha256",
        "page_count",
        "pdf_object_count"
      ],
      "properties": {
        "sink": {
          "enum": [
            "file",
            "stdout"
          ]
        },
        "bytes": {
          "$ref": "common.schema.json#/$defs/positive_safe_integer"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "pdf_object_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "font_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "font_face_id",
        "uri",
        "face_index",
        "bytes",
        "sha256",
        "units_per_em",
        "glyph_count"
      ],
      "properties": {
        "font_face_id": {
          "$ref": "common.schema.json#/$defs/id32"
        },
        "uri": {
          "$ref": "common.schema.json#/$defs/portable_relative_path"
        },
        "face_index": {
          "$ref": "common.schema.json#/$defs/id32"
        },
        "bytes": {
          "$ref": "common.schema.json#/$defs/positive_safe_integer"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "units_per_em": {
          "type": "integer",
          "minimum": 16,
          "maximum": 16384
        },
        "glyph_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "image_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_id",
        "attested_media_kind",
        "uri",
        "bytes",
        "sha256",
        "pixel_width",
        "pixel_height",
        "decoded_bytes"
      ],
      "properties": {
        "attested_media_kind": {
          "const": "png"
        },
        "image_id": {
          "$ref": "common.schema.json#/$defs/id32"
        },
        "uri": {
          "$ref": "common.schema.json#/$defs/portable_relative_path"
        },
        "bytes": {
          "$ref": "common.schema.json#/$defs/positive_safe_integer"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "pixel_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "pixel_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "decoded_bytes": {
          "$ref": "common.schema.json#/$defs/positive_safe_integer"
        }
      }
    },
    "media_declaration_font": {
      "oneOf": [
        {
          "$ref": "#/$defs/declared_font_media_declaration"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "legacy_unspecified"}}
        }
      ]
    },
    "media_declaration_image": {
      "oneOf": [
        {
          "$ref": "#/$defs/declared_image_media_declaration"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "legacy_unspecified"}}
        }
      ]
    },
    "declared_font_media_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "media_type"],
      "properties": {
        "kind": {"const": "declared"},
        "media_type": {
          "enum": ["sfnt-truetype-glyf", "ttc-truetype-glyf", "sfnt-cff1"]
        }
      }
    },
    "declared_image_media_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "media_type"],
      "properties": {
        "kind": {"const": "declared"},
        "media_type": {
          "enum": ["png", "svg-safe-1", "svg-safe-2", "jpeg-baseline"]
        }
      }
    },
    "production_font_record": {
      "oneOf": [
        {"$ref": "#/$defs/attested_production_font_record"},
        {"$ref": "#/$defs/legacy_production_font_declaration_record"}
      ]
    },
    "legacy_production_font_declaration_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attested_media_kind",
        "face_index",
        "font_face_id",
        "media_declaration",
        "sha256",
        "uri"
      ],
      "properties": {
        "attested_media_kind": {"type": "null"},
        "face_index": {"$ref": "common.schema.json#/$defs/id32"},
        "font_face_id": {"$ref": "common.schema.json#/$defs/id32"},
        "media_declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "legacy_unspecified"}}
        },
        "sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common.schema.json#/$defs/sha256"}
          ]
        },
        "uri": {"$ref": "common.schema.json#/$defs/portable_relative_path"}
      }
    },
    "attested_production_font_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attested_media_kind",
        "bytes",
        "face_index",
        "font_face_id",
        "glyph_count",
        "media_declaration",
        "sha256",
        "units_per_em",
        "uri"
      ],
      "properties": {
        "attested_media_kind": {
          "enum": [null, "sfnt-truetype-glyf", "ttc-truetype-glyf", "sfnt-cff1"]
        },
        "bytes": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "face_index": {"$ref": "common.schema.json#/$defs/id32"},
        "font_face_id": {"$ref": "common.schema.json#/$defs/id32"},
        "glyph_count": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "media_declaration": {"$ref": "#/$defs/media_declaration_font"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "units_per_em": {"type": "integer", "minimum": 16, "maximum": 16384},
        "uri": {"$ref": "common.schema.json#/$defs/portable_relative_path"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "media_declaration": {
                "properties": {"kind": {"const": "legacy_unspecified"}},
                "required": ["kind"]
              }
            }
          },
          "then": {"properties": {"attested_media_kind": {"type": "null"}}},
          "else": {
            "oneOf": [
              {
                "properties": {
                  "attested_media_kind": {"const": "sfnt-truetype-glyf"},
                  "media_declaration": {
                    "properties": {"media_type": {"const": "sfnt-truetype-glyf"}}
                  }
                }
              },
              {
                "properties": {
                  "attested_media_kind": {"const": "ttc-truetype-glyf"},
                  "media_declaration": {
                    "properties": {"media_type": {"const": "ttc-truetype-glyf"}}
                  }
                }
              },
              {
                "properties": {
                  "attested_media_kind": {"const": "sfnt-cff1"},
                  "media_declaration": {
                    "properties": {"media_type": {"const": "sfnt-cff1"}}
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "production_image_record": {
      "oneOf": [
        {"$ref": "#/$defs/attested_production_image_record"},
        {"$ref": "#/$defs/legacy_production_image_declaration_record"}
      ]
    },
    "legacy_production_image_declaration_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attested_media_kind",
        "image_id",
        "media_declaration",
        "sha256",
        "uri"
      ],
      "properties": {
        "attested_media_kind": {"type": "null"},
        "image_id": {"$ref": "common.schema.json#/$defs/id32"},
        "media_declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "legacy_unspecified"}}
        },
        "sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "common.schema.json#/$defs/sha256"}
          ]
        },
        "uri": {"$ref": "common.schema.json#/$defs/portable_relative_path"}
      }
    },
    "attested_production_image_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attested_media_kind",
        "bytes",
        "decoded_bytes",
        "image_id",
        "media_declaration",
        "pixel_height",
        "pixel_width",
        "sha256",
        "uri"
      ],
      "properties": {
        "attested_media_kind": {
          "enum": [null, "png", "svg-safe-1", "svg-safe-2", "jpeg-baseline"]
        },
        "bytes": {"$ref": "common.schema.json#/$defs/positive_safe_integer"},
        "decoded_bytes": {"$ref": "common.schema.json#/$defs/nonnegative_safe_integer"},
        "image_id": {"$ref": "common.schema.json#/$defs/id32"},
        "media_declaration": {"$ref": "#/$defs/media_declaration_image"},
        "pixel_height": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "pixel_width": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "uri": {"$ref": "common.schema.json#/$defs/portable_relative_path"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "media_declaration": {
                "properties": {"kind": {"const": "legacy_unspecified"}},
                "required": ["kind"]
              }
            }
          },
          "then": {"properties": {"attested_media_kind": {"type": "null"}}},
          "else": {
            "oneOf": [
              {
                "properties": {
                  "attested_media_kind": {"const": "png"},
                  "media_declaration": {"properties": {"media_type": {"const": "png"}}}
                }
              },
              {
                "properties": {
                  "attested_media_kind": {"const": "svg-safe-1"},
                  "media_declaration": {"properties": {"media_type": {"const": "svg-safe-1"}}}
                }
              },
              {
                "properties": {
                  "attested_media_kind": {"const": "svg-safe-2"},
                  "media_declaration": {"properties": {"media_type": {"const": "svg-safe-2"}}}
                }
              },
              {
                "properties": {
                  "attested_media_kind": {"const": "jpeg-baseline"},
                  "media_declaration": {"properties": {"media_type": {"const": "jpeg-baseline"}}}
                }
              }
            ]
          }
        }
      ]
    },
    "nullable_book_navigation_pair": {
      "oneOf": [
        {
          "properties": {
            "book_navigation_manifest": {"type": "null"},
            "book_navigation_manifest_fingerprint": {"type": "null"}
          }
        },
        {
          "properties": {
            "book_navigation_manifest": {"$ref": "machine-book-navigation-manifest.schema.json#/$defs/v2_manifest"},
            "book_navigation_manifest_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
          }
        }
      ]
    },
    "nullable_math_vector_pair": {
      "oneOf": [
        {
          "properties": {
            "math_vector_manifest": {"type": "null"},
            "math_vector_manifest_fingerprint": {"type": "null"}
          }
        },
        {
          "properties": {
            "math_vector_manifest": {"$ref": "machine-math-vector-manifest.schema.json"},
            "math_vector_manifest_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
          }
        }
      ]
    },
    "nullable_safe_vector_pair": {
      "oneOf": [
        {
          "properties": {
            "safe_vector_manifest": {"type": "null"},
            "safe_vector_manifest_fingerprint": {"type": "null"}
          }
        },
        {
          "properties": {
            "safe_vector_manifest": {"$ref": "machine-safe-vector-manifest.schema.json#/$defs/v2_manifest"},
            "safe_vector_manifest_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
          }
        }
      ]
    },
    "nullable_tagged_pdf_pair": {
      "oneOf": [
        {
          "properties": {
            "tagged_pdf_manifest": {"type": "null"},
            "tagged_pdf_manifest_fingerprint": {"type": "null"}
          }
        },
        {
          "properties": {
            "tagged_pdf_manifest": {"$ref": "machine-accessibility-manifest.schema.json#/$defs/v2_manifest"},
            "tagged_pdf_manifest_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "input_profile": {"const": "typaxis.machine-pdf/production-book-1"}
        },
        "required": ["input_profile"]
      },
      "then": {
        "properties": {
          "contract": {"const": "typaxis.contract/1.4"},
          "fonts": {
            "items": {"$ref": "#/$defs/production_font_record"}
          },
          "images": {
            "items": {"$ref": "#/$defs/production_image_record"}
          }
        },
        "required": [
          "book_navigation_manifest",
          "book_navigation_manifest_fingerprint",
          "math_vector_manifest",
          "math_vector_manifest_fingerprint",
          "safe_vector_manifest",
          "safe_vector_manifest_fingerprint",
          "tagged_pdf_manifest",
          "tagged_pdf_manifest_fingerprint"
        ],
        "allOf": [
          {
            "if": {
              "properties": {"status": {"const": "built"}},
              "required": ["status"]
            },
            "then": {
              "properties": {
                "book_navigation_manifest": {"$ref": "machine-book-navigation-manifest.schema.json#/$defs/v2_manifest"},
                "book_navigation_manifest_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
                "fonts": {
                  "items": {
                    "allOf": [
                      {"$ref": "#/$defs/production_font_record"},
                      {
                        "properties": {
                          "attested_media_kind": {
                            "enum": ["sfnt-truetype-glyf", "ttc-truetype-glyf", "sfnt-cff1"]
                          },
                          "media_declaration": {"$ref": "#/$defs/declared_font_media_declaration"}
                        }
                      }
                    ]
                  }
                },
                "images": {
                  "items": {
                    "allOf": [
                      {"$ref": "#/$defs/production_image_record"},
                      {
                        "properties": {
                          "attested_media_kind": {
                            "enum": ["png", "svg-safe-1", "svg-safe-2", "jpeg-baseline"]
                          },
                          "media_declaration": {"$ref": "#/$defs/declared_image_media_declaration"}
                        }
                      }
                    ]
                  }
                },
                "math_vector_manifest": {"$ref": "machine-math-vector-manifest.schema.json"},
                "math_vector_manifest_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
                "package_input": {
                  "allOf": [
                    {"$ref": "#/$defs/package_input_record"},
                    {"properties": {"contract": {"const": "typaxis.contract/1.4"}}}
                  ]
                },
                "safe_vector_manifest": {"$ref": "machine-safe-vector-manifest.schema.json#/$defs/v2_manifest"},
                "safe_vector_manifest_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
                "tagged_pdf_manifest": {"$ref": "machine-accessibility-manifest.schema.json#/$defs/v2_manifest"},
                "tagged_pdf_manifest_fingerprint": {"$ref": "common.schema.json#/$defs/sha256"}
              }
            },
            "else": {
              "allOf": [
                {"$ref": "#/$defs/nullable_book_navigation_pair"},
                {"$ref": "#/$defs/nullable_math_vector_pair"},
                {"$ref": "#/$defs/nullable_safe_vector_pair"},
                {"$ref": "#/$defs/nullable_tagged_pdf_pair"},
                {
                  "oneOf": [
                    {
                      "properties": {
                        "fonts": {
                          "items": {"$ref": "#/$defs/legacy_production_font_declaration_record"}
                        },
                        "images": {
                          "items": {"$ref": "#/$defs/legacy_production_image_declaration_record"}
                        },
                        "package_input": {
                          "allOf": [
                            {"$ref": "#/$defs/package_input_record"},
                            {
                              "properties": {
                                "contract": {
                                  "enum": [
                                    "typaxis.contract/1.0",
                                    "typaxis.contract/1.1",
                                    "typaxis.contract/1.2",
                                    "typaxis.contract/1.3"
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "properties": {
                        "fonts": {
                          "items": {"$ref": "#/$defs/attested_production_font_record"}
                        },
                        "images": {
                          "items": {"$ref": "#/$defs/attested_production_image_record"}
                        },
                        "package_input": {
                          "oneOf": [
                            {"type": "null"},
                            {
                              "allOf": [
                                {"$ref": "#/$defs/package_input_record"},
                                {
                                  "properties": {
                                    "contract": {
                                      "enum": [null, "typaxis.contract/1.4"]
                                    }
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      },
      "else": {
        "properties": {
          "fonts": {
            "items": {"$ref": "#/$defs/font_record"}
          },
          "images": {
            "items": {"$ref": "#/$defs/image_record"}
          }
        },
        "not": {
          "anyOf": [
            {"required": ["book_navigation_manifest"]},
            {"required": ["book_navigation_manifest_fingerprint"]},
            {"required": ["math_vector_manifest"]},
            {"required": ["math_vector_manifest_fingerprint"]},
            {"required": ["safe_vector_manifest"]},
            {"required": ["safe_vector_manifest_fingerprint"]},
            {"required": ["tagged_pdf_manifest"]},
            {"required": ["tagged_pdf_manifest_fingerprint"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "input_profile": {
            "const": "typaxis.machine-pdf/footnote-1"
          },
          "status": {
            "const": "built"
          }
        },
        "required": [
          "input_profile",
          "status"
        ]
      },
      "then": {
        "required": [
          "footnote_layout"
        ]
      },
      "else": {
        "not": {
          "required": [
            "footnote_layout"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "input_profile": {
            "const": "typaxis.machine-pdf/table-1"
          },
          "status": {
            "const": "built"
          }
        },
        "required": [
          "input_profile",
          "status"
        ]
      },
      "then": {
        "required": [
          "table_layouts"
        ]
      },
      "else": {
        "not": {
          "required": [
            "table_layouts"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "input_profile": {
            "const": "typaxis.reference-source/1"
          }
        }
      },
      "then": {
        "properties": {
          "package_input": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "input_profile": {
            "enum": [
              "typaxis.machine-pdf/basic-document-1",
              "typaxis.machine-pdf/columns-1",
              "typaxis.machine-pdf/float-1",
              "typaxis.machine-pdf/footnote-1",
              "typaxis.machine-pdf/header-footer-1",
              "typaxis.machine-pdf/paragraph-1",
              "typaxis.machine-pdf/production-book-1",
              "typaxis.machine-pdf/table-1"
            ]
          },
          "status": {
            "const": "built"
          }
        },
        "required": [
          "input_profile",
          "status"
        ]
      },
      "then": {
        "properties": {
          "package_input": {
            "allOf": [
              {
                "$ref": "#/$defs/package_input_record"
              },
              {
                "properties": {
                  "canonical_sha256": {
                    "$ref": "common.schema.json#/$defs/sha256"
                  },
                  "contract": {
                    "enum": [
                      "typaxis.contract/1.0",
                      "typaxis.contract/1.1",
                      "typaxis.contract/1.2",
                      "typaxis.contract/1.3",
                      "typaxis.contract/1.4"
                    ]
                  },
                  "profile_receipt_sha256": {
                    "$ref": "common.schema.json#/$defs/sha256"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "input_profile": {
            "enum": [
              "typaxis.machine-pdf/columns-1",
              "typaxis.machine-pdf/float-1",
              "typaxis.machine-pdf/header-footer-1"
            ]
          },
          "status": {
            "const": "built"
          }
        },
        "required": [
          "input_profile",
          "status"
        ]
      },
      "then": {
        "required": [
          "advanced_pagination"
        ]
      },
      "else": {
        "not": {
          "required": [
            "advanced_pagination"
          ]
        }
      }
    },
    {
      "oneOf": [
    {
      "properties": {
        "status": {
          "const": "built"
        },
        "layout": {
          "$ref": "#/$defs/layout_summary"
        },
        "output": {
          "$ref": "#/$defs/output_record"
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "failed"
        },
        "layout": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/layout_summary"
            }
          ]
        },
        "output": {
          "type": "null"
        }
      }
    }
      ]
    }
  ]
}
